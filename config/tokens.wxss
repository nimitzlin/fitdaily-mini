/**
 * FitDaily 设计 Token · v1.5 · Pastel + Glassmorphism
 * 日系手帐 · 抹茶绿 + 珊瑚红马卡龙 · 大圆角毛玻璃卡片
 * 全部页面通过 CSS 变量引用，禁止硬编码色值
 */
page {
  /* === 色板 === */
  --bg-page: #F1FAF0;            /* 奶绿背景（保留兼容） */
  --bg-page-top: #F4FBF1;        /* 渐变顶部更亮 */
  --bg-page-bot: #E5F1E1;        /* 渐变底部略深 */
  --bg-card: #FFFFFF;            /* 卡片白底（兼容旧用法） */

  /* 主色：抹茶绿（柔化） */
  --primary: #8ED08F;            /* 抹茶绿：边框/按钮/完成态 */
  --primary-light: #C7F2C0;
  --primary-deep: #98D8A0;
  --primary-soft: #E8F5E3;       /* 极浅薄荷（图表背景） */
  --primary-gradient: linear-gradient(135deg, #B8E2BA 0%, #8ED08F 100%);

  /* 强调：珊瑚红（柔化） */
  --accent-coral: #FF9A76;
  --accent-coral-light: #FFD4C2;
  --accent-coral-gradient: linear-gradient(135deg, #FFB89E 0%, #FF9A76 100%);

  --accent-yellow: #FCD884;
  --accent-blue: #98C1D9;
  --accent-water: #98C1D9;       /* 喝水色（统一命名） */

  /* === 文字 === */
  --text-main: #386641;          /* 深森林绿文字（禁用纯黑） */
  --text-sub: #6B8F6E;
  --text-mute: #A8BBA9;          /* 极弱提示 */
  --text-on-primary: #FFFFFF;

  /* === GI 红绿灯 === */
  --gi-low: #5FA86B;
  --gi-mid: #E9B44C;
  --gi-high: #E57B64;
  --gi-none: #BFC7BF;

  /* === 形状 === */
  --radius-card: 32rpx;          /* 主卡片（大圆角贴纸感） */
  --radius-pill: 999rpx;         /* 胶囊 */
  --radius-button: 24rpx;        /* 按钮 */
  --radius-icon: 20rpx;          /* 图标容器 */
  --radius-sm: 16rpx;            /* 小元素 */

  /* === 玻璃质感 === */
  --glass-bg: rgba(255, 255, 255, 0.72);
  --glass-bg-strong: rgba(255, 255, 255, 0.88);
  --glass-border: rgba(142, 208, 143, 0.18);
  --glass-blur: blur(24rpx);
  --glass-blur-strong: blur(40rpx);

  /* === 阴影（带主色 tint，不再用纯灰） === */
  --shadow-card: 0 8rpx 24rpx rgba(56, 102, 65, 0.08);
  --shadow-card-hover: 0 12rpx 32rpx rgba(142, 208, 143, 0.18);
  --shadow-fab: 0 16rpx 36rpx rgba(255, 154, 118, 0.4);
  --shadow-fab-hover: 0 20rpx 44rpx rgba(255, 154, 118, 0.5);
  --shadow-inset: inset 0 2rpx 4rpx rgba(255, 255, 255, 0.6);

  /* === 边框 === */
  --border-card: 2rpx solid rgba(142, 208, 143, 0.25);
  --border-card-strong: 3rpx solid var(--primary);
  --border-soft: 1rpx solid rgba(142, 208, 143, 0.15);

  /* === 动效 === */
  --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
  --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);
  --dur-fast: 180ms;
  --dur-med: 320ms;
  --dur-slow: 480ms;
}
