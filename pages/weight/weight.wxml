<view class="page">
  <!-- 录入卡 -->
  <view class="card wg-input-card">
    <view class="wg-row">
      <text class="wg-label">记录日期</text>
      <picker mode="date" value="{{pickDate}}" end="{{maxDate}}" bindchange="onPickDate" class="wg-picker">
        <view class="wg-picker-t">{{pickDate}}</view>
      </picker>
    </view>
    <view class="wg-row">
      <text class="wg-label">体重</text>
      <input class="wg-input" type="digit" maxlength="5" placeholder="如：65.5"
             value="{{input}}" bindinput="onInput" />
      <text class="wg-unit">kg</text>
    </view>
    <button class="btn-primary wg-btn" bindtap="onSave">
      {{pickDate === maxDate ? '记录今天' : '补录 ' + pickDate}}
    </button>
  </view>

  <!-- 趋势卡 -->
  <view class="card" wx:if="{{chart.length}}">
    <view class="wg-head">
      <text class="wg-title">体重趋势</text>
      <text class="wg-diff {{diffFirst <= 0 ? 'wg-down' : 'wg-up'}}">
        {{latest.weightKg}}kg · {{diffFirst <= 0 ? '↓' : '↑'}}{{diffFirst < 0 ? -diffFirst : diffFirst}}kg
      </text>
    </view>

    <!-- 折线图：连线 + 点 -->
    <view class="wg-chart">
      <!-- 连线（n>=2 才有） -->
      <view wx:for="{{segments}}" wx:key="index" class="wg-line"
            style="left: {{item.x1}}%; top: {{item.y1}}%;
                   width: {{item.len}}%;
                   transform: rotate({{item.deg}}deg);"></view>
      <!-- 点（单点也画，多点更画） -->
      <view wx:for="{{chart}}" wx:key="index" class="wg-dot"
            style="left: {{item.x}}%; top: {{item.y}}%;"></view>
    </view>
    <!-- x 轴：首尾 label（单点时两端相同，做兼容显示） -->
    <view wx:if="{{chart.length >= 2}}" class="wg-xaxis">
      <text>{{chart[0].label}} · {{chart[0].v}}kg</text>
      <text>{{chart[chart.length-1].label}} · {{chart[chart.length-1].v}}kg</text>
    </view>
    <view wx:elif="{{chart.length === 1}}" class="wg-xaxis wg-xaxis-single">
      <text>{{chart[0].label}} · {{chart[0].v}}kg</text>
    </view>
  </view>

  <!-- 历史列表 -->
  <view class="card" wx:if="{{records.length}}">
    <text class="wg-title">历史记录</text>
    <view wx:for="{{records}}" wx:key="date" class="wg-rec">
      <text class="wg-date">{{item.date}}</text>
      <text class="wg-val">{{item.weightKg}} kg</text>
      <view class="wg-rec-del" data-date="{{item.date}}" data-value="{{item.weightKg}}" bindtap="onDelete">删除</view>
    </view>
  </view>

  <view wx:if="{{!records.length}}" class="card wg-empty">
    <text class="wg-e-emoji">⚖️</text>
    <text class="wg-e-t">记下第一笔体重吧</text>
    <text class="wg-e-d">每天同一时间（晨起空腹最佳）测量更准</text>
  </view>
</view>
