<view class="page page-enter">
  <!-- 步骤 1: 选动作 -->
  <view wx:if="{{!selectedExercise}}" class="card shine-top">
    <view class="tl-row-h">
      <view class="emoji-chip emoji-chip--fruit" style="--chip-size: 56rpx"><text>🎯</text></view>
      <text class="tl-title">选择动作</text>
    </view>

    <scroll-view scroll-x class="tl-parts" enhanced show-scrollbar="{{false}}">
      <view wx:for="{{partLabels}}" wx:key="key"
            class="tl-part press-shrink {{currentPart === item.key ? 'is-active' : ''}}"
            data-part="{{item.key}}"
            bindtap="selectPart" hover-class="tl-part--hover" hover-stay-time="120">
        {{item.label}}
      </view>
    </scroll-view>

    <view class="tl-exlist stagger">
      <view wx:for="{{exercises}}" wx:key="id"
            wx:if="{{item.bodyPart === currentPart}}"
            class="tl-ex press-shrink"
            data-id="{{item.id}}"
            bindtap="selectExercise" hover-class="tl-ex--hover" hover-stay-time="120">
        <view class="tl-ex-main">
          <text class="tl-ex-name">{{item.name}}</text>
          <text class="tl-ex-meta">{{item.equipment}}</text>
        </view>
        <view class="tl-ex-tag" wx:if="{{item.isCompound}}">复合</view>
        <text class="tl-ex-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 步骤 2: 填组 -->
  <view wx:if="{{selectedExercise}}" class="card shine-top">
    <view class="tl-row-h">
      <view class="emoji-chip emoji-chip--train" style="--chip-size: 56rpx"><text>🏋️</text></view>
      <text class="tl-title">{{selectedExercise.name}}</text>
      <view class="tl-repick press-shrink" bindtap="selectExercise" data-id="">‹ 换动作</view>
    </view>
    <text class="tl-meta">{{selectedExercise.equipment}} · {{selectedExercise.isCompound ? '复合动作' : '孤立动作'}}</text>

    <view wx:if="{{editingLogId}}" class="tl-edit-banner">
      <text class="tl-edit-banner-t">✏️ 正在编辑这条记录</text>
      <view class="tl-edit-cancel press-shrink" bindtap="onCancelEdit">取消</view>
    </view>

    <view class="tl-sets">
      <view wx:for="{{sets}}" wx:key="*this" class="tl-set-row press-shrink">
        <text class="tl-set-num">#{{index + 1}}</text>
        <view class="tl-set-input">
          <text class="tl-set-lbl">{{selectedExercise.bodyPart === 'cardio' ? '时间 分' : '次数'}}</text>
          <input type="number" value="{{item.reps}}" data-idx="{{index}}" bindinput="onSetReps" class="tl-input" />
        </view>
        <view wx:if="{{selectedExercise.bodyPart !== 'cardio'}}" class="tl-set-input">
          <text class="tl-set-lbl">重量 kg</text>
          <input type="digit" value="{{item.weightKg}}" data-idx="{{index}}" bindinput="onSetWeight" class="tl-input" />
        </view>
        <view wx:else class="tl-set-input">
          <text class="tl-set-lbl">距离 km（可选）</text>
          <input type="digit" placeholder="0" value="{{item.weightKg}}" data-idx="{{index}}" bindinput="onSetWeight" class="tl-input" />
        </view>
        <view class="tl-set-del" data-idx="{{index}}" bindtap="removeSet">×</view>
      </view>
    </view>

    <view class="tl-add-set press-shrink" bindtap="addSet" hover-class="tl-add-set--hover" hover-stay-time="120">+ 加一组</view>

    <view class="tl-rest-row">
      <text class="tl-rest-lbl">⏱ 休息 {{restSec}}s</text>
      <view class="tl-rest-btn {{timerRunning ? 'is-running pulse' : ''}}"
            bindtap="{{timerRunning ? 'stopTimer' : 'startTimer'}}">
        {{timerRunning ? restLeft + 's 点击停止' : '开始休息'}}
      </view>
    </view>

    <button class="btn-primary tl-save press-shrink" bindtap="saveLog">{{editingLogId ? '更新训练记录' : '保存训练记录'}}</button>
  </view>

  <!-- 今日训练列表 -->
  <view wx:if="{{todayLogs.length}}" class="card">
    <view class="tl-row-h">
      <view class="emoji-chip emoji-chip--leaf" style="--chip-size: 56rpx"><text>📋</text></view>
      <text class="tl-title">今日训练</text>
      <text class="tl-log-count">{{todayLogs.length}} 条</text>
    </view>
    <view class="stagger">
      <view wx:for="{{todayLogs}}" wx:key="id" class="tl-log-item press-shrink {{editingLogId === item.id ? 'is-editing' : ''}}">
        <view class="tl-log-info">
          <text class="tl-log-name">{{item.exName}}</text>
          <text class="tl-log-sets">{{item.summary}}</text>
        </view>
        <view class="tl-log-ops">
          <view class="tl-log-edit press-shrink" data-id="{{item.id}}" bindtap="onEditLog">编辑</view>
          <view class="tl-log-del press-shrink" data-id="{{item.id}}" bindtap="onRemoveLog">删除</view>
        </view>
      </view>
    </view>
  </view>
</view>
