.page {
  padding: 24rpx;
}

/* ---- 顶部日期选择器 ---- */
.data-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx;
}
.data-head-arrow {
  width: 64rpx;
  height: 64rpx;
  line-height: 60rpx;
  text-align: center;
  font-size: 40rpx;
  color: var(--primary);
  background: var(--primary-light);
  border-radius: 50%;
  flex-shrink: 0;
}
.data-head-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.data-head-date {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}
.data-head-date-num { font-size: 30rpx; font-weight: 700; color: var(--text-main); }
.data-head-week { font-size: 22rpx; color: var(--text-sub); }
.data-today-btn {
  font-size: 20rpx;
  padding: 4rpx 10rpx;
  border: 2rpx solid var(--primary);
  color: var(--primary-deep);
  border-radius: 6rpx;
  margin-left: auto;
}
.data-today-tag {
  font-size: 20rpx;
  padding: 4rpx 10rpx;
  background: var(--accent-coral);
  color: #fff;
  border-radius: 6rpx;
  margin-left: auto;
}
.data-head-sub { font-size: 22rpx; color: var(--text-sub); }

/* ---- 月历 ---- */
.data-cal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.data-cal-title { font-size: 30rpx; font-weight: 700; color: var(--text-main); }
.data-cal-arrow {
  width: 56rpx;
  height: 56rpx;
  line-height: 52rpx;
  text-align: center;
  font-size: 32rpx;
  color: var(--primary);
  background: var(--primary-light);
  border-radius: 50%;
}
.data-cal-weekhead {
  display: flex;
  margin-bottom: 8rpx;
}
.data-cal-whd {
  flex: 1;
  text-align: center;
  font-size: 22rpx;
  color: var(--text-sub);
  font-weight: 600;
}
.data-cal-row { display: flex; }
.data-cal-cell {
  flex: 1;
  height: 96rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  border-radius: 10rpx;
  margin: 2rpx 0;
}
.data-cal-cell.is-out .data-cal-day { color: var(--text-sub); opacity: 0.4; }
.data-cal-cell.is-today .data-cal-day { color: var(--accent-coral); font-weight: 700; }
.data-cal-cell.is-selected {
  background: var(--primary);
}
.data-cal-cell.is-selected .data-cal-day { color: #fff; font-weight: 700; }
.data-cal-day { font-size: 26rpx; color: var(--text-main); }
.data-dot {
  position: absolute;
  bottom: 6rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--primary);
}
.data-dot.train {
  background: transparent;
  font-size: 18rpx;
  width: auto;
  height: auto;
  right: 6rpx;
  bottom: 4rpx;
  left: auto;
  line-height: 1;
}
.data-cal-legend {
  display: flex;
  gap: 20rpx;
  margin-top: 16rpx;
  font-size: 22rpx;
  color: var(--text-sub);
}
.data-cal-legend-item { display: flex; align-items: center; gap: 6rpx; }
.data-cal-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
}
.data-cal-dot.today { background: var(--accent-coral); }
.data-cal-dot.selected { background: var(--primary); }

/* ---- 汇总 ---- */
.data-summary-row {
  display: flex;
  justify-content: space-between;
}
.data-sum-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}
.data-sum-num { font-size: 32rpx; font-weight: 700; color: var(--primary); }
.data-sum-unit { font-size: 20rpx; color: var(--text-sub); margin-top: 4rpx; }

/* ---- 训练打卡 ---- */
.data-train-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.data-train-card.is-done { background: var(--primary-light); }
.data-train-emoji { font-size: 40rpx; }
.data-train-main { flex: 1; display: flex; flex-direction: column; gap: 4rpx; }
.data-train-t { font-size: 28rpx; font-weight: 600; color: var(--text-main); }
.data-train-sub { font-size: 22rpx; color: var(--text-sub); }

/* ---- 区块标题 ---- */
.data-row-h {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}
.data-emoji { font-size: 32rpx; }
.data-title { font-size: 30rpx; font-weight: 700; color: var(--text-main); flex: 1; }
.data-count { font-size: 22rpx; color: var(--text-sub); }

/* ---- 饮食/训练记录条目 ---- */
.data-log-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 0;
  border-bottom: 2rpx dashed var(--primary-light);
}
.data-log-row:last-child { border-bottom: none; }
.data-log-info { flex: 1; display: flex; flex-direction: column; gap: 4rpx; min-width: 0; }
.data-log-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.data-log-meta { font-size: 22rpx; color: var(--text-sub); }
.data-log-ops {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  flex-shrink: 0;
  margin-left: 12rpx;
}
.data-log-op {
  font-size: 22rpx;
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
  text-align: center;
  font-weight: 600;
}
.data-edit {
  background: var(--primary-light);
  color: var(--primary-deep);
  border: 2rpx solid var(--primary);
}
.data-del {
  background: #fff5f3;
  color: var(--gi-high);
  border: 2rpx solid var(--gi-high);
}

/* ---- 饮水 ---- */
.data-water-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.data-water-emoji { font-size: 36rpx; }
.data-water-main { flex: 1; display: flex; flex-direction: column; gap: 4rpx; }
.data-water-title { font-size: 26rpx; font-weight: 600; color: var(--text-main); }
.data-water-val { font-size: 22rpx; color: var(--text-sub); }
.data-water-btn {
  flex-shrink: 0;
  padding: 12rpx 20rpx;
}

/* ---- 底部操作区 ---- */
.data-fab-wrap {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 24rpx;
  padding: 0 24rpx;
  z-index: 10;
}
.data-fab-row {
  display: flex;
  gap: 16rpx;
  background: var(--bg-card, #fff);
  border-radius: 16rpx;
  padding: 16rpx;
  box-shadow: 0 8rpx 24rpx rgba(56, 102, 65, 0.12);
}
.data-fab-half {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 18rpx 0;
  background: var(--primary-light);
  border-radius: 12rpx;
}
.data-fab-emoji { font-size: 30rpx; }
.data-fab-t { font-size: 26rpx; font-weight: 700; color: var(--primary-deep); }
