.fe-title {
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 24rpx;
}

.fe-ai-banner {
  background: rgba(152, 193, 217, 0.18);
  color: #4a7a96;
  border-radius: 16rpx;
  padding: 14rpx 20rpx;
  font-size: 24rpx;
  margin-bottom: 20rpx;
}

.fe-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.fe-no-mt {
  margin-bottom: 12rpx;
}

.fe-label {
  width: 240rpx;
  font-size: 26rpx;
  color: var(--text-main);
  flex-shrink: 0;
}

.fe-input {
  flex: 1;
  background: var(--bg-page);
  border: 2rpx solid var(--primary-light);
  border-radius: 16rpx;
  padding: 14rpx 20rpx;
  font-size: 28rpx;
}

.fe-picker {
  background: var(--bg-page);
  border: 2rpx solid var(--primary-light);
  border-radius: 16rpx;
  padding: 14rpx 20rpx;
  font-size: 28rpx;
}

.fe-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx 20rpx;
  margin-bottom: 8rpx;
}

.fe-cell {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.fe-cell .fe-label {
  width: auto;
}

.fe-warn {
  font-size: 24rpx;
  color: #b8862f;
  background: rgba(233, 180, 76, 0.15);
  border-radius: 16rpx;
  padding: 12rpx 20rpx;
  margin: 8rpx 0 4rpx;
}

/* GI 区块 */
.fe-gi-block {
  margin-top: 24rpx;
  border-top: 2rpx dashed var(--primary-light);
  padding-top: 24rpx;
}

.fe-gi-input {
  max-width: 200rpx;
  text-align: center;
}

.gi-badge {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 18rpx;
  border-radius: var(--radius-pill);
  font-size: 22rpx;
  font-weight: 700;
}

.gb-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
}

.gb-low { background: rgba(95,168,107,.15); color: var(--gi-low); }
.gb-low .gb-dot { background: var(--gi-low); }
.gb-mid { background: rgba(233,180,76,.18); color: #b8862f; }
.gb-mid .gb-dot { background: var(--gi-mid); }
.gb-high { background: rgba(229,123,100,.16); color: var(--gi-high); }
.gb-high .gb-dot { background: var(--gi-high); }
.gb-none { background: rgba(191,199,191,.25); color: var(--text-sub); }
.gb-none .gb-dot { background: var(--gi-none); }

.fe-switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}

.fe-hint {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--text-sub);
}

.fe-save {
  margin-top: 32rpx;
}

/* T21 OCR 智能匹配候选卡 */
.fe-candidates {
  background: linear-gradient(135deg, #f0f9ff 0%, #e0f2fe 100%);
  border: 2rpx solid #38bdf8;
  border-radius: 16rpx;
  padding: 20rpx;
  margin: 20rpx 0;
}

.fe-cand-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 26rpx;
  color: #0369a1;
  margin-bottom: 16rpx;
  font-weight: 600;
}

.fe-cand-close {
  font-size: 32rpx;
  color: #94a3b8;
  padding: 0 12rpx;
}

.fe-cand-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #fff;
  border-radius: 12rpx;
  padding: 16rpx;
  margin-bottom: 12rpx;
}

.fe-cand-row:active {
  background: #f8fafc;
}

.fe-cand-row:last-child {
  margin-bottom: 0;
}

.fe-cand-main {
  flex: 1;
  min-width: 0;
}

.fe-cand-name {
  font-size: 28rpx;
  color: #0f172a;
  font-weight: 500;
  display: block;
  margin-bottom: 6rpx;
}

.fe-cand-meta {
  font-size: 22rpx;
  color: #64748b;
  display: block;
}

.fe-cand-tag {
  font-size: 20rpx;
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
  margin-left: 12rpx;
  flex-shrink: 0;
}

.fe-cand-tag-cfc {
  background: #dcfce7;
  color: #15803d;
}

.fe-cand-tag-builtin {
  background: #fef3c7;
  color: #b45309;
}

.fe-cand-tag-user {
  background: #ede9fe;
  color: #6d28d9;
}
