<view class="page">
  <!-- 搜索框 -->
  <view class="fs-search card">
    <input class="fs-input" placeholder="搜索食物，如：鸡胸肉 / 毛豆 / 苹果" value="{{keyword}}"
           bindinput="onKeyword" confirm-type="search" focus="{{true}}" />
  </view>

  <!-- 分类筛选 -->
  <scroll-view scroll-x class="fs-cats" enhanced show-scrollbar="{{false}}">
    <view wx:for="{{cats}}" wx:key="*this"
          class="fs-cat {{catIndex === index ? 'fs-cat-on' : ''}}"
          data-index="{{index}}" bindtap="onCat">{{item}}</view>
  </scroll-view>

  <!-- T21: 常用快捷入口（空搜索 + 全部分类时显示） -->
  <block wx:if="{{quickRows.length}}">
    <view class="fs-sec">🔥 常用 10 大</view>
    <view class="fs-quick-grid">
      <view wx:for="{{quickRows}}" wx:key="id" class="fs-quick-row" data-id="{{item.id}}" bindtap="onPick">
        <text class="fs-quick-name">{{item.name}}</text>
        <text class="fs-quick-meta">{{item.per100.calories}} kcal · 蛋白{{item.per100.protein}}</text>
      </view>
    </view>
  </block>

  <!-- 我的食物（置顶） -->
  <block wx:if="{{myRows.length}}">
    <view class="fs-sec">⭐ 我的食物</view>
    <view wx:for="{{myRows}}" wx:key="id" class="fs-row" data-id="{{item.id}}" bindtap="onPick">
      <view class="fs-main">
        <text class="fs-name">{{item.name}}</text>
        <text class="fs-meta">{{item.per100.calories}} kcal/100g · 蛋白{{item.per100.protein}} 碳水{{item.per100.carbs}} 脂肪{{item.per100.fat}}</text>
      </view>
      <view class="gi-badge {{item.giCls}}"><view class="gb-dot"></view><text>{{item.giText}}</text></view>
    </view>
  </block>

  <!-- 内置库（带分页信息 + 加载更多） -->
  <view class="fs-sec">🥗 食物库<text wx:if="{{total > 0}}" class="fs-sec-meta">　共 {{total}} 条，已显示 {{shown}}</text></view>
  <view wx:for="{{rows}}" wx:key="id" class="fs-row" data-id="{{item.id}}" bindtap="onPick">
    <view class="fs-main">
      <text class="fs-name">{{item.name}}</text>
      <text class="fs-meta">{{item.per100.calories}} kcal/100g · 蛋白{{item.per100.protein}} 碳水{{item.per100.carbs}} 脂肪{{item.per100.fat}}</text>
    </view>
    <view class="gi-badge {{item.giCls}}"><view class="gb-dot"></view><text>{{item.giText}}</text></view>
  </view>

  <!-- 加载更多（剩余条数 > 0 时显示） -->
  <view wx:if="{{shown < total}}" class="fs-more" bindtap="onMore">
    ↓ 加载更多（{{total - shown}} 条未显示）
  </view>

  <!-- T22.2: 没找到 → CTA 引导自定义录入（不只一句提示） -->
  <view wx:if="{{!rows.length && !myRows.length && !quickRows.length && keyword}}" class="fs-empty">
    <text class="fs-empty-title">没找到「{{keyword}}」</text>
    <text class="fs-empty-hint">这可能是加工食品 / 养生品 / 合成菜（如芝麻丸、阿胶糕、宫保鸡丁），数据库没收录</text>
    <button class="btn-primary fs-empty-btn" bindtap="onCreateCustom">＋ 自定义录入「{{keyword}}」</button>
    <text class="fs-empty-tip">点上面按钮直接录入，保存后会加进「我的食物库」，下次可直接搜到</text>
  </view>
</view>
