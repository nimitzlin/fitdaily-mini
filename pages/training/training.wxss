.page {
  padding: 24rpx;
}

/* 训练主按钮 */
.train-hero {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 32rpx 24rpx;
  transition: all 0.3s ease;
}
.train-hero.is-done {
  background: linear-gradient(135deg, var(--primary-light), var(--bg-card));
  border: 4rpx solid var(--primary);
}
.tr-hero-emoji { font-size: 60rpx; }
.tr-hero-main { flex: 1; display: flex; flex-direction: column; gap: 8rpx; }
.tr-hero-title { font-size: 36rpx; font-weight: 700; color: var(--text-main); }
.tr-hero-sub { font-size: 24rpx; color: var(--text-sub); line-height: 1.5; }

/* 通用行标题 */
.tr-row-h {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}
.tr-emoji { font-size: 32rpx; }
.tr-title { font-size: 30rpx; font-weight: 700; color: var(--text-main); flex: 1; }
.tr-counts { font-size: 22rpx; color: var(--text-sub); }
.tr-count { font-size: 32rpx; font-weight: 700; color: var(--primary); }
.tr-count-unit { font-size: 22rpx; margin: 0 6rpx; }

/* 今日训练 */
.tr-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 32rpx 0;
}
.tr-empty-emoji { font-size: 60rpx; }
.tr-empty-t { font-size: 26rpx; color: var(--text-sub); }
.tr-empty-btn {
  margin-top: 8rpx;
  padding: 16rpx 60rpx;
  font-size: 28rpx;
  width: auto;
}
.tr-log-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding: 16rpx 0;
  border-bottom: 2rpx dashed var(--primary-light);
}
.tr-log-row:last-of-type { border-bottom: none; }
.tr-log-name { font-size: 28rpx; font-weight: 600; color: var(--text-main); }
.tr-log-sets { font-size: 22rpx; color: var(--text-sub); }
.tr-add-btn {
  margin-top: 16rpx;
  text-align: center;
  padding: 14rpx;
  background: var(--bg-page);
  border-radius: 12rpx;
  font-size: 26rpx;
  color: var(--primary);
  font-weight: 600;
}

/* 月历 */
.tr-cal-head {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  text-align: center;
  margin-bottom: 8rpx;
}
.tr-cal-hd { font-size: 22rpx; color: var(--text-sub); padding: 8rpx 0; }
.tr-cal-row { display: grid; grid-template-columns: repeat(7, 1fr); gap: 4rpx; }
.tr-cal-cell {
  aspect-ratio: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 8rpx;
  font-size: 24rpx;
}
.tr-cal-cell.is-out { color: transparent; }
.tr-cal-day { font-size: 26rpx; color: var(--text-main); }
.tr-cal-cell.is-today {
  background: var(--primary-light);
  font-weight: 700;
}
.tr-cal-cell.is-today .tr-cal-day { color: var(--primary); }
.tr-cal-cell.is-trained {
  background: var(--primary);
}
.tr-cal-cell.is-trained .tr-cal-day { color: #fff; font-weight: 700; }
.tr-cal-legend {
  display: flex;
  gap: 24rpx;
  margin-top: 16rpx;
  font-size: 22rpx;
  color: var(--text-sub);
}
.tr-cal-legend-item { display: flex; align-items: center; gap: 8rpx; }
.tr-cal-dot { width: 20rpx; height: 20rpx; border-radius: 6rpx; }
.tr-cal-dot.today { background: var(--primary-light); border: 2rpx solid var(--primary); }
.tr-cal-dot.trained { background: var(--primary); }

/* PR 入口 */
.tr-pr-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 0;
}
.tr-pr-emoji { font-size: 40rpx; }
.tr-pr-main { flex: 1; display: flex; flex-direction: column; gap: 4rpx; }
.tr-pr-title { font-size: 28rpx; font-weight: 700; color: var(--text-main); }
.tr-pr-sub { font-size: 22rpx; color: var(--text-sub); }
.tr-pr-arrow { font-size: 36rpx; color: var(--text-sub); }
/* T19 消耗徽章 */
.tr-count.tr-burn {
  color: var(--accent-coral);
  font-size: 30rpx;
}
