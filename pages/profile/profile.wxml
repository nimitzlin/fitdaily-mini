<view class="page">
  <!-- 每日目标 -->
  <view class="card">
    <view class="pf-title-row">
      <text class="pf-emoji">🎯</text>
      <text class="pf-title">每日目标</text>
      <view class="pf-edit" bindtap="goGoalSettings">✏️ 编辑</view>
    </view>
    <view class="pf-grid">
      <view class="pf-cell"><text class="pf-num">{{profile.calorieTarget}}</text><text class="pf-unit">热量 kcal</text></view>
      <view class="pf-cell"><text class="pf-num">{{profile.proteinTarget}}g</text><text class="pf-unit">蛋白质</text></view>
      <view class="pf-cell"><text class="pf-num">{{profile.carbsTarget}}g</text><text class="pf-unit">碳水</text></view>
      <view class="pf-cell"><text class="pf-num">{{profile.fatTarget}}g</text><text class="pf-unit">脂肪</text></view>
      <view class="pf-cell"><text class="pf-num">{{profile.fiberTarget}}g</text><text class="pf-unit">纤维</text></view>
      <view class="pf-cell"><text class="pf-num">{{profile.waterTargetMl}}ml</text><text class="pf-unit">饮水</text></view>
    </view>
  </view>

  <!-- 功能入口 -->
  <view class="card pf-menu">
    <view class="pf-item" bindtap="goMyFoods">
      <text class="pf-i-emoji">🍳</text>
      <view class="pf-i-main"><text class="pf-i-name">我的食物库</text><text class="pf-i-desc">管理自定义食物</text></view>
      <text class="pf-arrow">›</text>
    </view>
    <view class="pf-item" bindtap="goVision">
      <text class="pf-i-emoji">📷</text>
      <view class="pf-i-main"><text class="pf-i-name">拍照估算设置</text><text class="pf-i-desc">{{visionReady ? '服务已就绪 ✅' : '配置拍照估算服务'}}</text></view>
      <text class="pf-arrow">›</text>
    </view>
    <view class="pf-item" bindtap="goWeight">
      <text class="pf-i-emoji">⚖️</text>
      <view class="pf-i-main"><text class="pf-i-name">体重记录</text><text class="pf-i-desc">曲线与趋势</text></view>
      <text class="pf-arrow">›</text>
    </view>
  </view>

  <!-- 关于 + 更新日志入口 -->
  <view class="card pf-about" bindtap="toggleChangelog">
    <text class="pf-about-t">每日健身伴侣 FitDaily</text>
    <view class="pf-about-meta">
      <text class="pf-about-version">{{currentVersion}}</text>
      <text class="pf-about-date">{{currentDate}}</text>
      <text class="pf-about-arrow">查看更新 ›</text>
    </view>
  </view>

  <!-- 更新日志弹层 -->
  <view wx:if="{{showChangelog}}" class="pf-changelog-mask" bindtap="closeChangelog">
    <view class="pf-changelog-sheet" catchtap="">
      <view class="pf-changelog-head">
        <text class="pf-changelog-title">📋 更新日志</text>
        <view class="pf-changelog-close" bindtap="closeChangelog">×</view>
      </view>
      <scroll-view scroll-y class="pf-changelog-scroll">
        <view wx:for="{{changelog}}" wx:key="version" class="pf-clog-entry">
          <view class="pf-clog-head">
            <text class="pf-clog-version {{item.version === currentVersion ? 'is-current' : ''}}">{{item.version}}</text>
            <text class="pf-clog-date">{{item.date}}</text>
          </view>
          <text class="pf-clog-title">{{item.title}}</text>
          <view class="pf-clog-items">
            <text wx:for="{{item.items}}" wx:for-item="line" wx:key="*this" class="pf-clog-line">{{line}}</text>
          </view>
        </view>
        <view style="height: 40rpx"></view>
      </scroll-view>
    </view>
  </view>
</view>
