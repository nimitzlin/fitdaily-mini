.page {
  padding: 24rpx;
}

.pf-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.pf-emoji {
  font-size: 36rpx;
}

.pf-title {
  font-size: 32rpx;
  font-weight: 700;
  flex: 1;
}

.pf-edit {
  font-size: 24rpx;
  color: var(--primary);
  padding: 8rpx 16rpx;
  border: 2rpx solid var(--primary-light);
  border-radius: 12rpx;
}

.pf-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-top: 24rpx;
}

.pf-cell {
  background: var(--bg-page);
  border-radius: 20rpx;
  padding: 16rpx 8rpx;
  text-align: center;
}

.pf-num {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-main);
}

.pf-unit {
  font-size: 20rpx;
  color: var(--text-sub);
}

.pf-menu {
  margin-top: 24rpx;
  padding: 8rpx 24rpx;
}

.pf-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 26rpx 0;
  border-bottom: 2rpx dashed var(--primary-light);
}

.pf-item:last-child {
  border-bottom: none;
}

.pf-i-emoji {
  font-size: 40rpx;
}

.pf-i-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.pf-i-name {
  font-size: 30rpx;
  font-weight: 700;
}

.pf-i-desc {
  font-size: 22rpx;
  color: var(--text-sub);
}

.pf-arrow {
  font-size: 36rpx;
  color: var(--text-sub);
}

.pf-about {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: 28rpx;
}

.pf-about-t {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--text-sub);
}

.pf-about-d {
  font-size: 22rpx;
  color: var(--text-sub);
}

/* 更新日志弹层 */
.pf-changelog-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}
.pf-changelog-sheet {
  width: 100%;
  height: 80vh;
  background: var(--bg-page, #F1FAF0);
  border-top-left-radius: 24rpx;
  border-top-right-radius: 24rpx;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}
.pf-changelog-head {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-bottom: 2rpx solid var(--primary-light);
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
}
.pf-changelog-title { font-size: 32rpx; font-weight: 700; color: var(--text-main); flex: 1; }
.pf-changelog-close {
  width: 56rpx;
  height: 56rpx;
  line-height: 52rpx;
  text-align: center;
  font-size: 40rpx;
  color: var(--text-sub);
  background: var(--bg-page, #F1FAF0);
  border-radius: 50%;
}
.pf-changelog-scroll {
  flex: 1;
  min-height: 0;
  height: 100%;
  padding: 16rpx 24rpx;
  box-sizing: border-box;
}
.pf-clog-entry {
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
  border: 2rpx solid var(--primary-light);
}
.pf-clog-head {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin-bottom: 8rpx;
}
.pf-clog-version {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-main);
  background: var(--primary-light);
  color: var(--primary-deep);
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
}
.pf-clog-version.is-current {
  background: var(--accent-coral, #FF9A76);
  color: #fff;
}
.pf-clog-date { font-size: 22rpx; color: var(--text-sub); }
.pf-clog-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main);
  display: block;
  margin-bottom: 12rpx;
}
.pf-clog-items { display: flex; flex-direction: column; gap: 8rpx; }
.pf-clog-line {
  font-size: 24rpx;
  color: var(--text-main);
  line-height: 1.6;
}

/* 升级关于卡 */
.pf-about-meta {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin-top: 8rpx;
}
.pf-about-version {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--primary-deep);
  background: var(--primary-light);
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}
.pf-about-date { font-size: 22rpx; color: var(--text-sub); }
.pf-about-arrow { font-size: 22rpx; color: var(--primary); margin-left: auto; }
