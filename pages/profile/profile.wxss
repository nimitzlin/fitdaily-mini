/* ========== Profile Page · v1.5 ========== */
.page {
  padding: 32rpx 28rpx;
}

/* ========== Title Row ========== */
.pf-title-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.pf-title {
  font-size: 36rpx;
  font-weight: 800;
  flex: 1;
  color: var(--text-main);
  letter-spacing: -0.5rpx;
}

.pf-edit {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--primary-deep);
  padding: 10rpx 20rpx;
  background: var(--primary-soft);
  border: 2rpx solid rgba(142, 208, 143, 0.4);
  border-radius: var(--radius-pill);
}

/* ========== Goal Grid ========== */
.pf-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-top: 4rpx;
}

.pf-cell {
  background: var(--glass-bg-strong);
  backdrop-filter: blur(10rpx);
  -webkit-backdrop-filter: blur(10rpx);
  border-radius: var(--radius-card);
  padding: 20rpx 8rpx;
  text-align: center;
  border: var(--border-soft);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.pf-num {
  font-size: 36rpx;
  font-weight: 800;
  color: var(--primary-deep);
  font-variant-numeric: tabular-nums;
  letter-spacing: -0.5rpx;
}

.pf-unit {
  font-size: 20rpx;
  color: var(--text-sub);
}

/* ========== Menu ========== */
.pf-menu {
  margin-top: 28rpx;
  padding: 8rpx 0;
}

.pf-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 12rpx;
  border-bottom: var(--border-soft);
  position: relative;
  overflow: hidden;
}

.pf-item:last-child {
  border-bottom: none;
}

.pf-item--hover {
  background: var(--primary-soft);
  transition: background var(--dur-fast) var(--ease-out);
}

.pf-i-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.pf-i-name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-main);
}

.pf-i-desc {
  font-size: 22rpx;
  color: var(--text-sub);
}

.pf-arrow {
  font-size: 36rpx;
  color: var(--text-mute);
  font-weight: 300;
  transition: transform var(--dur-fast) var(--ease-out),
              color var(--dur-fast) var(--ease-out);
}

.pf-item--hover .pf-arrow {
  transform: translateX(6rpx);
  color: var(--primary);
}

/* ========== About Card ========== */
.pf-about {
  margin-top: 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 32rpx;
  background: linear-gradient(135deg, var(--primary-soft) 0%, rgba(255, 255, 255, 0.85) 100%);
  border: 2rpx solid rgba(142, 208, 143, 0.3);
  text-align: center;
}

.pf-about-t {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-main);
}

.pf-about-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 8rpx;
  flex-wrap: wrap;
  justify-content: center;
}

.pf-about-version {
  font-size: 24rpx;
  font-weight: 800;
  color: var(--primary-deep);
  background: rgba(255, 255, 255, 0.7);
  padding: 6rpx 16rpx;
  border-radius: var(--radius-pill);
  border: 2rpx solid rgba(142, 208, 143, 0.4);
}

.pf-about-date {
  font-size: 22rpx;
  color: var(--text-sub);
}

.pf-about-arrow {
  font-size: 22rpx;
  color: var(--primary-deep);
  font-weight: 600;
}

/* ========== 更新日志弹层 ========== */
.pf-changelog-mask {
  position: fixed;
  inset: 0;
  background: rgba(56, 102, 65, 0.4);
  backdrop-filter: blur(6rpx);
  -webkit-backdrop-filter: blur(6rpx);
  z-index: 100;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  animation: maskIn var(--dur-med) var(--ease-out);
}

@keyframes maskIn {
  from { opacity: 0; }
  to   { opacity: 1; }
}

.pf-changelog-sheet {
  width: 100%;
  height: 80vh;
  background: linear-gradient(180deg, var(--bg-page-top) 0%, var(--bg-page) 100%);
  border-top-left-radius: 32rpx;
  border-top-right-radius: 32rpx;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  animation: sheetIn var(--dur-slow) var(--ease-out);
  box-shadow: 0 -20rpx 40rpx rgba(56, 102, 65, 0.15);
}

@keyframes sheetIn {
  from { transform: translateY(100%); }
  to   { transform: translateY(0); }
}

.pf-changelog-head {
  display: flex;
  align-items: center;
  padding: 28rpx 28rpx;
  background: var(--glass-bg-strong);
  backdrop-filter: blur(20rpx);
  border-bottom: var(--border-soft);
  flex-shrink: 0;
}

.pf-changelog-title {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--text-main);
  flex: 1;
  letter-spacing: -0.5rpx;
}

.pf-changelog-close {
  width: 64rpx;
  height: 64rpx;
  line-height: 60rpx;
  text-align: center;
  font-size: 40rpx;
  color: var(--text-sub);
  background: var(--primary-soft);
  border-radius: 50%;
  font-weight: 300;
}

.pf-changelog-scroll {
  flex: 1;
  min-height: 0;
  height: 100%;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
}

.pf-clog-entry {
  background: var(--glass-bg);
  backdrop-filter: blur(16rpx);
  border-radius: var(--radius-card);
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
  border: var(--border-soft);
}

.pf-clog-head {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.pf-clog-version {
  font-size: 26rpx;
  font-weight: 800;
  color: var(--primary-deep);
  background: var(--primary-soft);
  padding: 6rpx 16rpx;
  border-radius: var(--radius-pill);
  letter-spacing: -0.3rpx;
}

.pf-clog-version.is-current {
  background: var(--accent-coral-gradient);
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(255, 154, 118, 0.35);
}

.pf-clog-date {
  font-size: 22rpx;
  color: var(--text-sub);
}

.pf-clog-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-main);
  display: block;
  margin-bottom: 12rpx;
}

.pf-clog-items {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.pf-clog-line {
  font-size: 24rpx;
  color: var(--text-main);
  line-height: 1.7;
}
