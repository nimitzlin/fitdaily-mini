.page {
  padding: 24rpx;
}

.water-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.wc-emoji {
  font-size: 48rpx;
}

.wc-main {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.wc-title {
  font-size: 28rpx;
  font-weight: 700;
}

.wc-val {
  font-size: 24rpx;
  color: var(--text-sub);
}

.wc-btn {
  padding: 10rpx 24rpx;
  font-size: 26rpx;
}

.empty {
  padding: 20rpx 8rpx 8rpx;
  font-size: 24rpx;
  color: var(--text-sub);
}

.fab {
  position: fixed;
  right: 40rpx;
  bottom: calc(60rpx + env(safe-area-inset-bottom));
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: var(--primary);
  color: #fff;
  font-size: 60rpx;
  line-height: 104rpx;
  text-align: center;
  font-weight: 700;
  box-shadow: 0 8rpx 24rpx rgba(56, 102, 65, 0.25);
  z-index: 50;
}
