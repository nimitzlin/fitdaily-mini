.page {
  padding: 24rpx;
}

.water-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.wc-emoji {
  font-size: 48rpx;
}

.wc-main {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.wc-title {
  font-size: 28rpx;
  font-weight: 700;
}

.wc-val {
  font-size: 24rpx;
  color: var(--text-sub);
}

.wc-btn {
  padding: 10rpx 24rpx;
  font-size: 26rpx;
}

.empty {
  padding: 20rpx 8rpx 8rpx;
  font-size: 24rpx;
  color: var(--text-sub);
}

.fab {
  position: fixed;
  right: 40rpx;
  bottom: calc(60rpx + env(safe-area-inset-bottom));
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: var(--primary);
  color: #fff;
  font-size: 60rpx;
  line-height: 104rpx;
  text-align: center;
  font-weight: 700;
  box-shadow: 0 8rpx 24rpx rgba(56, 102, 65, 0.25);
  z-index: 50;
}

/* 训练打卡卡 */
.train-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  transition: background 0.3s ease;
}
.train-card.is-done {
  background: linear-gradient(135deg, var(--primary-light), var(--bg-card));
  border: 4rpx solid var(--primary);
}
.tr-emoji { font-size: 40rpx; }
.tr-main { flex: 1; display: flex; flex-direction: column; gap: 4rpx; }
.tr-title { font-size: 30rpx; font-weight: 700; color: var(--text-main); }
.tr-sub { font-size: 22rpx; color: var(--text-sub); }
.tr-arrow { font-size: 28rpx; color: var(--text-sub); }
.train-card.is-done .tr-arrow { color: var(--primary); font-size: 22rpx; }
