<view class="page today-page">
  <!-- 顶部品牌栏 -->
  <view class="today-hero">
    <view class="hero-greet">
      <text class="hero-emoji">🌱</text>
      <view class="hero-titles">
        <text class="hero-title">今日饮食</text>
        <text class="hero-sub">{{todayDate}} · 距离目标还有 {{remainKcal}} kcal</text>
      </view>
    </view>
    <view class="hero-ring">
      <text class="hero-ring-num">{{stats.calories}}</text>
      <text class="hero-ring-target">/ {{profile.calorieTarget}} kcal</text>
    </view>
  </view>

  <!-- 营养看板 -->
  <view class="card">
    <nutrition-dashboard stats="{{stats}}" profile="{{profile}}" />
  </view>

  <!-- 训练 + 饮水 双列网格 -->
  <view class="grid-2col">
    <view class="card mini-card mini-card--train {{trained ? 'is-done' : ''}}"
          bindtap="onToggleTrain" hover-class="mini-card--hover" hover-stay-time="120">
      <view class="mini-emoji">{{trained ? '💪' : '🤸'}}</view>
      <view class="mini-title">{{trained ? '已打卡' : '训练'}}</view>
      <view class="mini-sub" wx:if="{{trained}}">+300 kcal 目标</view>
      <view class="mini-sub" wx:else>点击打卡</view>
    </view>
    <view class="card mini-card mini-card--water" bindlongpress="onWaterLongPress"
          hover-class="mini-card--hover" hover-stay-time="120">
      <view class="mini-emoji">💧</view>
      <view class="mini-title">{{water}}ml</view>
      <view class="mini-sub">目标 {{profile.waterTargetMl}}ml</view>
      <view class="mini-action" catchtap="onAddWater">+250</view>
    </view>
  </view>

  <!-- 四餐时间线 -->
  <meal-section
    wx:for="{{meals}}"
    wx:key="key"
    meal="{{item.key}}"
    label="{{item.label}}"
    logs="{{item.logs}}"
    expanded="{{true}}"
    bind:itemtap="onItemTap"
    bind:itemedit="onItemEdit"
    bind:itemremove="onItemRemove"
  >
    <food-card wx:for="{{item.logs}}" wx:for-item="log" wx:key="id" log="{{log}}"
      bind:tap="onItemTap" bind:edit="onItemEdit" bind:remove="onItemRemove" />
    <view wx:if="{{!item.logs.length}}" class="empty">还没记录，点右下角 + 开始</view>
  </meal-section>

  <view style="height: 160rpx"></view>

  <!-- 悬浮添加按钮 -->
  <view class="fab" hover-class="fab--hover" hover-stay-time="120" bindtap="openSheet">＋</view>

  <!-- 录入方式弹层 -->
  <half-screen-sheet show="{{sheetShow}}" bind:close="closeSheet" bind:choose="onChooseEntry" />
</view>
