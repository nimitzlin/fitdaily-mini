<view class="page page-enter">
  <view class="card">
    <view class="vs-title-row">
      <view class="emoji-chip emoji-chip--camera" style="--chip-size: 64rpx"><text>📷</text></view>
      <text class="vs-title">拍照估算设置</text>
    </view>
    <text class="vs-desc">拍一下菜品照片，自动估算热量与营养（可选服务，按需启用）。</text>

    <!-- 服务商预设 -->
    <view class="vs-row vs-no-mt">
      <text class="vs-label">服务商预设</text>
      <picker mode="selector" range="{{presets}}" range-key="label" value="{{presetIndex}}" bindchange="onPreset" class="vs-picker">
        <view>{{presets[presetIndex].label}}</view>
      </picker>
    </view>

    <!-- API 地址 -->
    <view class="vs-col">
      <text class="vs-label">API 地址</text>
      <input class="vs-input" value="{{baseUrl}}" bindinput="onUrl" placeholder="https://api.minimaxi.com/v1/chat/completions" />
    </view>

    <!-- 模型 -->
    <view class="vs-col">
      <text class="vs-label">模型名称</text>
      <input class="vs-input" value="{{model}}" bindinput="onModel" placeholder="model-id" />
    </view>

    <!-- 接入密钥 -->
    <view class="vs-col">
      <view class="vs-key-head">
        <text class="vs-label">接入密钥 {{hasKey ? '（已保存）' : ''}}</text>
        <text wx:if="{{hasKey && !showKey}}" class="vs-masked" bindtap="toggleShowKey">{{keyMasked || '已存本机 👁'}}</text>
      </view>
      <input class="vs-input" password="{{!showKey}}" value="{{keyInput}}" bindinput="onKeyInput"
             placeholder="{{hasKey ? '输入新密钥可覆盖' : '粘贴你的服务密钥'}}" />
      <text class="vs-hint">🔒 密钥仅保存在你的手机本地，不上传服务器、不参与云同步、不进日志</text>
    </view>

    <!-- 测试连接 -->
    <button class="btn-ghost vs-test press-shrink" loading="{{testing}}" bindtap="onTest">
      {{testing ? '测试中…' : '测试连接'}}
    </button>
    <view wx:if="{{testMsg}}" class="vs-result {{testOk ? 'vs-ok' : 'vs-bad'}}">{{testMsg}}</view>

    <button class="btn-primary vs-save press-shrink" bindtap="onSaveTap">保存配置</button>
  </view>

  <view class="card vs-tips">
    <text class="vs-tips-title">💡 使用提示</text>
    <text class="vs-tip">· 默认是国内站接入地址，国内账号密钥直接用；如果是国际站再切到「国际站」</text>
    <text class="vs-tip">· 拍照估算结果可作为草稿，保存前可逐项修改</text>
    <text class="vs-tip">· 一餐多道菜会拆成多条，逐条确认</text>
  </view>
</view>
