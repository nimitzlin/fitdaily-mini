/* ========== 动作选择 tabs ========== */
.prc-tabs {
  white-space: nowrap;
  margin: 0 -28rpx 20rpx;
  padding: 0 28rpx;
}
.prc-tab-row {
  display: inline-flex;
  gap: 14rpx;
  padding: 4rpx 0;
}
.prc-tab {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  padding: 14rpx 24rpx;
  border-radius: var(--radius-lg);
  background: var(--glass-bg);
  border: 1rpx solid var(--border-card);
  box-shadow: var(--shadow-card);
  transition: transform var(--dur-fast) var(--ease-out), background var(--dur-fast) var(--ease-out);
  flex-shrink: 0;
}
.prc-tab--active {
  background: var(--primary-gradient);
  border-color: transparent;
  color: #fff;
  transform: translateY(-2rpx);
  box-shadow: 0 6rpx 16rpx rgba(255, 138, 101, 0.32);
}
.prc-tab--active .prc-tab-pr {
  color: rgba(255, 255, 255, 0.92);
}
.prc-tab--empty {
  opacity: 0.55;
}
.prc-tab--hover {
  background: var(--primary-soft);
}
.prc-tab--active.prc-tab--hover {
  background: var(--primary-gradient);
}
.prc-tab-name {
  font-size: 26rpx;
  font-weight: 600;
}
.prc-tab-pr {
  font-size: 22rpx;
  color: var(--text-muted);
  margin-top: 2rpx;
  font-variant-numeric: tabular-nums;
}

/* ========== Hero 顶部卡 ========== */
.prc-hero {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 32rpx 28rpx;
}
.prc-hero-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.prc-hero-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
}
.prc-hero-pr {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
  margin-top: 4rpx;
}
.prc-hero-pr-num {
  font-size: 64rpx;
  font-weight: 700;
  color: var(--primary-deep);
  line-height: 1;
  font-variant-numeric: tabular-nums;
}
.prc-hero-pr-unit {
  font-size: 26rpx;
  color: var(--text-sub);
  font-weight: 600;
}
.prc-hero-pr-delta {
  margin-left: 12rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--primary-deep);
  background: var(--primary-soft);
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
}
.prc-hero-pr-delta--down {
  color: #5a5a5a;
  background: rgba(0, 0, 0, 0.06);
}
.prc-hero-empty {
  font-size: 24rpx;
  color: var(--text-muted);
  margin-top: 4rpx;
}

/* ========== 趋势图卡 ========== */
.prc-chart-card {
  padding: 28rpx 24rpx 24rpx;
}
.prc-chart-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 16rpx;
}
.prc-chart-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
}
.prc-diff {
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  font-size: 24rpx;
  font-weight: 600;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  font-variant-numeric: tabular-nums;
}
.prc-up {
  color: var(--primary-deep);
  background: var(--primary-soft);
}
.prc-down {
  color: #5a5a5a;
  background: rgba(0, 0, 0, 0.06);
}
.prc-diff-arrow {
  font-size: 26rpx;
}
.prc-diff-delta {
  font-size: 22rpx;
}

.prc-chart {
  position: relative;
  width: 100%;
  height: 280rpx;
  margin-top: 12rpx;
}
.prc-line {
  position: absolute;
  height: 3rpx;
  background: linear-gradient(90deg, #FFB07A 0%, #FF8A65 100%);
  transform-origin: 0 50%;
  border-radius: 999rpx;
  box-shadow: 0 2rpx 6rpx rgba(255, 138, 101, 0.32);
}
.prc-dot {
  position: absolute;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--primary-gradient);
  transform: translate(-50%, -50%);
  box-shadow: 0 0 0 4rpx rgba(255, 138, 101, 0.18);
  transition: transform var(--dur-fast) var(--ease-out);
}
.prc-dot:hover {
  transform: translate(-50%, -50%) scale(1.4);
}
.prc-dot-tip {
  position: absolute;
  bottom: 24rpx;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 6rpx 14rpx;
  border-radius: 16rpx;
  background: rgba(50, 50, 50, 0.86);
  color: #fff;
  white-space: nowrap;
  opacity: 0;
  pointer-events: none;
  transition: opacity var(--dur-fast) var(--ease-out);
}
.prc-dot:hover .prc-dot-tip {
  opacity: 1;
}
.prc-dot-tip-date {
  font-size: 20rpx;
  opacity: 0.85;
}
.prc-dot-tip-val {
  font-size: 22rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}
.prc-xaxis {
  display: flex;
  justify-content: space-between;
  margin-top: 14rpx;
  font-size: 22rpx;
  color: var(--text-muted);
  font-variant-numeric: tabular-nums;
}

/* 单点卡 */
.prc-chart-single {
  padding-bottom: 32rpx;
}
.prc-single {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 8rpx 4rpx;
}
.prc-single-main {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.prc-single-date {
  font-size: 24rpx;
  color: var(--text-muted);
}
.prc-single-val {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--primary-deep);
  font-variant-numeric: tabular-nums;
}
.prc-single-tip {
  font-size: 22rpx;
  color: var(--text-muted);
  margin-top: 4rpx;
}

/* ========== 空状态 ========== */
.prc-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx;
  gap: 14rpx;
}
.prc-e-t {
  font-size: 28rpx;
  color: var(--text);
  font-weight: 600;
}
.prc-e-d {
  font-size: 24rpx;
  color: var(--text-muted);
}

/* ========== 历史列表 ========== */
.prc-history {
  padding: 28rpx 24rpx;
}
.prc-history-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 16rpx;
}
.prc-history-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
}
.prc-history-count {
  font-size: 22rpx;
  color: var(--text-muted);
}
.prc-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 12rpx;
  border-radius: var(--radius-md);
  transition: background var(--dur-fast) var(--ease-out);
}
.prc-row:hover {
  background: var(--primary-soft);
}
.prc-row-date {
  font-size: 26rpx;
  color: var(--text);
  font-variant-numeric: tabular-nums;
}
.prc-row-val {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--primary-deep);
  font-variant-numeric: tabular-nums;
}
