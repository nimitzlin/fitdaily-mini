{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "strict": true,
    "noImplicitAny": true,
    "removeComments": true,
    "preserveConstEnums": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "typeRoots": ["./typings", "./node_modules/@types"],
    "types": [],
    "lib": ["ES2020"],
    "outDir": "./",
    "rootDir": "./",
    "sourceMap": true,
    "declaration": false
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules"]
}
