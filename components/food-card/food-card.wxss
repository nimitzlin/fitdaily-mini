.fc {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #fff;
  border: var(--border-card);
  border-radius: var(--radius-card);
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
}

.fc-gi {
  flex-shrink: 0;
}

.fc-main {
  flex: 1;
  min-width: 0;
}

.fc-row1 {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}

.fc-name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-main);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.fc-kcal {
  flex-shrink: 0;
  margin-left: 12rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--accent-coral);
}

.fc-row2 {
  display: flex;
  gap: 16rpx;
  margin-top: 6rpx;
}

.fc-meta {
  font-size: 22rpx;
  color: var(--text-sub);
}

.fc-ops {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  flex-shrink: 0;
}

.fc-op {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 22rpx;
  color: var(--text-sub);
  padding: 8rpx 12rpx;
  border: 2rpx solid transparent;
  border-radius: 8rpx;
}

.fc-edit {
  background: var(--primary-light);
  color: var(--primary-deep);
  border-color: var(--primary);
  font-weight: 600;
}

.fc-del {
  background: #fff5f3;
  color: var(--gi-high);
  border-color: var(--gi-high);
}

.fc-op-icon {
  font-size: 22rpx;
}

.fc-op-t {
  font-size: 22rpx;
}
