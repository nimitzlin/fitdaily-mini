/* Stagger-self：元素自身作为 stagger 项，用 nth-of-type 让兄弟元素错开
   适用于 wx:for 包裹的 view（展开后是同级元素） */
.stagger-self:nth-of-type(1) { animation: pageItemIn var(--dur-med) var(--ease-out) both; animation-delay: 0ms; }
.stagger-self:nth-of-type(2) { animation: pageItemIn var(--dur-med) var(--ease-out) both; animation-delay: 40ms; }
.stagger-self:nth-of-type(3) { animation: pageItemIn var(--dur-med) var(--ease-out) both; animation-delay: 80ms; }
.stagger-self:nth-of-type(4) { animation: pageItemIn var(--dur-med) var(--ease-out) both; animation-delay: 120ms; }
.stagger-self:nth-of-type(5) { animation: pageItemIn var(--dur-med) var(--ease-out) both; animation-delay: 160ms; }
.stagger-self:nth-of-type(6) { animation: pageItemIn var(--dur-med) var(--ease-out) both; animation-delay: 200ms; }
.stagger-self:nth-of-type(7) { animation: pageItemIn var(--dur-med) var(--ease-out) both; animation-delay: 240ms; }
.stagger-self:nth-of-type(8) { animation: pageItemIn var(--dur-med) var(--ease-out) both; animation-delay: 280ms; }
.stagger-self:nth-of-type(n+9) { animation: pageItemIn var(--dur-med) var(--ease-out) both; animation-delay: 320ms; }

/* Hover 微缩放（小程序用 hover-class 触发） */
.hover-scale {
  transition: transform var(--dur-fast) var(--ease-out);
}
.hover-scale:hover {
  transform: scale(0.97);
}

/* 按压态 */
.press-shrink {
  transition: transform var(--dur-fast) var(--ease-out);
}
.press-shrink:active {
  transform: scale(0.94);
}

/* Pulse 持续动效（用于训练打卡、饮水提醒等） */
@keyframes pulse {
  0%, 100% { transform: scale(1); }
  50%      { transform: scale(1.04); }
}
.pulse {
  animation: pulse 2.4s var(--ease-out) infinite;
}

/* Float 漂浮（用于 FAB / 装饰元素） */
@keyframes float {
  0%, 100% { transform: translateY(0); }
  50%      { transform: translateY(-6rpx); }
}
.float { animation: float 3.2s var(--ease-out) infinite; }

/* Shine 流光（用于 hero 卡路里大数字） */
@keyframes shine {
  0%   { background-position: -200% center; }
  100% { background-position: 200% center; }
}
.shine-text {
  background: linear-gradient(90deg,
    var(--primary-deep) 0%,
    var(--accent-coral) 50%,
    var(--primary-deep) 100%);
  background-size: 200% auto;
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  animation: shine 4s linear infinite;
}
