@import "config/tokens.wxss";

/* 全局基础样式 */
page {
  /* Pastel 渐变背景（顶部亮、底部略深） */
  background: linear-gradient(180deg, var(--bg-page-top) 0%, var(--bg-page) 35%, var(--bg-page-bot) 100%);
  background-attachment: fixed;
  color: var(--text-main);
  font-size: 28rpx;
  line-height: 1.6;
  /* 数字等宽（卡路里显示更稳） */
  font-variant-numeric: tabular-nums;
}

/* 卡片基类 · 毛玻璃 + 大圆角 + 入场动画 */
.card {
  position: relative;
  background: var(--glass-bg);
  backdrop-filter: var(--glass-blur);
  -webkit-backdrop-filter: var(--glass-blur);
  border: var(--border-card);
  border-radius: var(--radius-card);
  padding: 32rpx;
  box-shadow: var(--shadow-card);
  /* 入场动画 */
  animation: cardIn var(--dur-med) var(--ease-out) both;
  transition: box-shadow var(--dur-fast) var(--ease-out),
              transform var(--dur-fast) var(--ease-out);
}

/* 卡片交错入场（前 6 张） */
.card:nth-child(1) { animation-delay: 0ms; }
.card:nth-child(2) { animation-delay: 60ms; }
.card:nth-child(3) { animation-delay: 120ms; }
.card:nth-child(4) { animation-delay: 180ms; }
.card:nth-child(5) { animation-delay: 240ms; }
.card:nth-child(6) { animation-delay: 300ms; }

@keyframes cardIn {
  from {
    opacity: 0;
    transform: translateY(20rpx) scale(0.98);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

/* 按钮基类 */
.btn-primary {
  background: var(--primary-gradient);
  color: var(--text-on-primary);
  border-radius: var(--radius-button);
  font-weight: 700;
  padding: 20rpx 32rpx;
  box-shadow: var(--shadow-card);
  transition: transform var(--dur-fast) var(--ease-out),
              box-shadow var(--dur-fast) var(--ease-out);
}
.btn-primary:active {
  transform: scale(0.97);
  box-shadow: var(--shadow-card-hover);
}

.btn-ghost {
  background: var(--glass-bg-strong);
  border: 2rpx solid var(--primary);
  color: var(--primary-deep);
  border-radius: var(--radius-button);
  padding: 16rpx 28rpx;
  transition: transform var(--dur-fast) var(--ease-out),
              background var(--dur-fast) var(--ease-out);
}
.btn-ghost:active {
  transform: scale(0.97);
  background: var(--primary-soft);
}

/* 顶部高光（装饰，可选） */
.shine-top {
  position: relative;
  overflow: hidden;
}
.shine-top::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 80rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.5) 0%, transparent 100%);
  pointer-events: none;
}

/* ========== Emoji Chip · 彩色背景圆形 icon 容器 ==========
 * 使用方法：
 *   <view class="emoji-chip emoji-chip--water"><text>💧</text></view>
 * 修改 size 用 --chip-size
 */
.emoji-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: var(--chip-size, 72rpx);
  height: var(--chip-size, 72rpx);
  border-radius: 50%;
  font-size: calc(var(--chip-size, 72rpx) * 0.55);
  background: var(--chip-bg, var(--primary-soft));
  box-shadow: var(--shadow-inset);
  transition: transform var(--dur-fast) var(--ease-spring);
  flex-shrink: 0;
}
.emoji-chip--water   { background: linear-gradient(135deg, #DCEAF6 0%, #C5DEEF 100%); --chip-bg: #DCEAF6; }
.emoji-chip--train   { background: linear-gradient(135deg, #FFE4D9 0%, #FFCDB8 100%); --chip-bg: #FFE4D9; }
.emoji-chip--food    { background: linear-gradient(135deg, var(--primary-light) 0%, #B8E2BA 100%); }
.emoji-chip--leaf    { background: linear-gradient(135deg, #E8F5E3 0%, #C8E6D2 100%); }
.emoji-chip--scale   { background: linear-gradient(135deg, #FFF3D6 0%, #FCE5A8 100%); }
.emoji-chip--camera  { background: linear-gradient(135deg, #E8DDFF 0%, #D4C5F9 100%); }
.emoji-chip--search  { background: linear-gradient(135deg, var(--primary-light) 0%, #A8D8B9 100%); }
.emoji-chip--pencil  { background: linear-gradient(135deg, #FFF3D6 0%, #FCD884 100%); }
.emoji-chip--fruit   { background: linear-gradient(135deg, #FFD6E0 0%, #FFB8C8 100%); }
.emoji-chip--rice    { background: linear-gradient(135deg, #FFF8E1 0%, #FFEFC2 100%); }
.emoji-chip--meat    { background: linear-gradient(135deg, #FFD9D2 0%, #F4A09C 100%); }
.emoji-chip--vege    { background: linear-gradient(135deg, #DDF2DD 0%, #B8E0B8 100%); }

/* ========== 动画 Hook ========== */

/* Page 入场：父级加 .page-enter，子元素逐个出现 */
.page-enter > * {
  animation: pageItemIn var(--dur-med) var(--ease-out) both;
}
.page-enter > *:nth-child(1) { animation-delay: 0ms; }
.page-enter > *:nth-child(2) { animation-delay: 50ms; }
.page-enter > *:nth-child(3) { animation-delay: 100ms; }
.page-enter > *:nth-child(4) { animation-delay: 150ms; }
.page-enter > *:nth-child(5) { animation-delay: 200ms; }
.page-enter > *:nth-child(6) { animation-delay: 250ms; }
.page-enter > *:nth-child(7) { animation-delay: 300ms; }
.page-enter > *:nth-child(8) { animation-delay: 350ms; }

@keyframes pageItemIn {
  from { opacity: 0; transform: translateY(16rpx); }
  to   { opacity: 1; transform: translateY(0); }
}

/* Stagger：列表项交错入场（作用于容器内的多个同级子元素） */
.stagger > * {
  animation: pageItemIn var(--dur-med) var(--ease-out) both;
}
.stagger > *:nth-child(1) { animation-delay: 0ms; }
.stagger > *:nth-child(2) { animation-delay: 40ms; }
.stagger > *:nth-child(3) { animation-delay: 80ms; }
.stagger > *:nth-child(4) { animation-delay: 120ms; }
.stagger > *:nth-child(5) { animation-delay: 160ms; }
.stagger > *:nth-child(6) { animation-delay: 200ms; }
.stagger > *:nth-child(7) { animation-delay: 240ms; }
.stagger > *:nth-child(8) { animation-delay: 280ms; }
.stagger > *:nth-child(n+9) { animation-delay: 320ms; }

/* Stagger-self：元素自身作为 stagger 项，用 nth-of-type 让兄弟元素错开
   适用于 wx:for 包裹的 view（展开后是同级元素） */
.stagger-self:nth-of-type(1) { animation: pageItemIn var(--dur-med) var(--ease-out) both; animation-delay: 0ms; }
.stagger-self:nth-of-type(2) { animation: pageItemIn var(--dur-med) var(--ease-out) both; animation-delay: 40ms; }
.stagger-self:nth-of-type(3) { animation: pageItemIn var(--dur-med) var(--ease-out) both; animation-delay: 80ms; }
.stagger-self:nth-of-type(4) { animation: pageItemIn var(--dur-med) var(--ease-out) both; animation-delay: 120ms; }
.stagger-self:nth-of-type(5) { animation: pageItemIn var(--dur-med) var(--ease-out) both; animation-delay: 160ms; }
.stagger-self:nth-of-type(6) { animation: pageItemIn var(--dur-med) var(--ease-out) both; animation-delay: 200ms; }
.stagger-self:nth-of-type(7) { animation: pageItemIn var(--dur-med) var(--ease-out) both; animation-delay: 240ms; }
.stagger-self:nth-of-type(8) { animation: pageItemIn var(--dur-med) var(--ease-out) both; animation-delay: 280ms; }
.stagger-self:nth-of-type(n+9) { animation: pageItemIn var(--dur-med) var(--ease-out) both; animation-delay: 320ms; }

/* Hover 微缩放（小程序用 hover-class 触发） */
.hover-scale {
  transition: transform var(--dur-fast) var(--ease-out);
}
.hover-scale:hover {
  transform: scale(0.97);
}

/* 按压态 */
.press-shrink {
  transition: transform var(--dur-fast) var(--ease-out);
}
.press-shrink:active {
  transform: scale(0.94);
}

/* Pulse 持续动效（用于训练打卡、饮水提醒等） */
@keyframes pulse {
  0%, 100% { transform: scale(1); }
  50%      { transform: scale(1.04); }
}
.pulse {
  animation: pulse 2.4s var(--ease-out) infinite;
}

/* Float 漂浮（用于 FAB / 装饰元素） */
@keyframes float {
  0%, 100% { transform: translateY(0); }
  50%      { transform: translateY(-6rpx); }
}
.float { animation: float 3.2s var(--ease-out) infinite; }

/* Shine 流光（用于 hero 卡路里大数字） */
@keyframes shine {
  0%   { background-position: -200% center; }
  100% { background-position: 200% center; }
}
.shine-text {
  background: linear-gradient(90deg,
    var(--primary-deep) 0%,
    var(--accent-coral) 50%,
    var(--primary-deep) 100%);
  background-size: 200% auto;
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  animation: shine 4s linear infinite;
}
